{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "summit-custom-builders",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "summitcustombuilders.net/*",
      "zone_name": "summitcustombuilders.net"
    },
    {
      "pattern": "www.summitcustombuilders.net/*",
      "zone_name": "summitcustombuilders.net"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "INQUIRY_RATE_LIMIT": "8"
  },
  "d1_databases": [
    {
      "binding": "INQUIRIES",
      "database_name": "summit-custom-builders-inquiries",
      "database_id": "54081328-f98e-4ef8-936b-75387361a017"
    }
  ],
  "observability": {
    "enabled": true
  }
}
