# Build canonical URLs for the live domain. No trailing slash.
SITE_URL=https://www.summitcustombuilders.net
# Local previews are noindex by default. Set to true only for production builds.
PUBLIC_INDEXING=false
PORT=3000
HOST=127.0.0.1
# Use an absolute persistent, private directory on the deployed server.
INQUIRY_DATA_DIR=.data/inquiries
# Maximum form attempts per direct peer in ten minutes.
INQUIRY_RATE_LIMIT=8
# Optional HTTPS endpoint. New inquiries are always stored before delivery.
# INQUIRY_WEBHOOK_URL=
# INQUIRY_WEBHOOK_TOKEN=
# Optional: add a verified Search Console HTML verification token at build time.
# GOOGLE_SITE_VERIFICATION=
